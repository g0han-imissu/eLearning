generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ImportJobType {
  TEACHER
  STUDENT
}

enum ImportJobStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  ROLLED_BACK
}

enum ImportRowStatus {
  SUCCESS
  ERROR
  SKIPPED
  ROLLED_BACK
}

enum ImportSource {
  CSV
  XLSX
  MANUAL
  API
}

enum ClassStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum EnrollmentStatus {
  PENDING
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum ContentType {
  VIDEO
  DOCUMENT
  QUIZ
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  code      String    @unique // organizationCode: dùng làm prefix username, hiển thị cho Org Admin
  status    OrgStatus @default(ACTIVE)
  plan      String    @default("FREE")
  maxUsers  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users        User[]
  programs     Program[]
  courses      Course[]
  classes      Class[]
  enrollments  Enrollment[]
  lectures     Lecture[]
  registration OrganizationRegistrationRequest?
  importJobs   ImportJob[]

  @@map("organizations")
}

model OrganizationRegistrationRequest {
  id             String             @id @default(cuid())
  orgName        String
  contactName    String
  email          String
  phone          String?
  expectedUsers  Int?
  note           String?
  status         RegistrationStatus @default(PENDING)
  rejectReason   String?
  reviewedById   String?
  reviewedAt     DateTime?
  organizationId String?            @unique
  createdAt      DateTime           @default(now())

  reviewedBy   User?         @relation("ReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("organization_registration_requests")
}

model User {
  id             String       @id @default(cuid())
  organizationId String?
  email          String?      @unique // optional: user import không email đăng nhập bằng username
  username       String?      @unique // "bkhn.gv001" — chứa sẵn org code, unique toàn cục
  userCode       String? // mã GV/SV do tổ chức cấp (từ SIS)
  department     String?
  mustChangePassword Boolean  @default(false)
  passwordHash   String
  fullName       String
  phone          String?
  avatarUrl      String?
  bio            String?
  specialization String?
  status         UserStatus   @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  taughtClasses      Class[]             @relation("TeacherClasses")
  enrollments        Enrollment[]
  ownedLectures      Lecture[]
  roles              UserRole[]
  attendances        SessionAttendance[]
  refreshTokens      RefreshToken[]
  passwordOtp        PasswordOtp?
  emailVerification  EmailVerification?
  teacherCourses     TeacherCourse[]
  reviewedRequests   OrganizationRegistrationRequest[] @relation("ReviewedRequests")
  createdImportJobs  ImportJob[]

  @@unique([organizationId, userCode])
  @@index([organizationId, status])
  @@map("users")
}

model ImportJob {
  id             String          @id @default(cuid())
  organizationId String
  type           ImportJobType
  source         ImportSource    @default(CSV)
  fileName       String?
  status         ImportJobStatus @default(PROCESSING)
  totalRows      Int             @default(0)
  successCount   Int             @default(0)
  errorCount     Int             @default(0)
  createdById    String
  createdAt      DateTime        @default(now())
  completedAt    DateTime?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  rows           ImportRow[]

  @@index([organizationId, createdAt])
  @@map("import_jobs")
}

model ImportRow {
  id            String          @id @default(cuid())
  jobId         String
  rowNumber     Int
  rawData       Json
  status        ImportRowStatus @default(ERROR)
  errorMessage  String?
  createdUserId String?
  tempPassword  String? // chỉ với user không email; xóa khi user đổi mật khẩu hoặc admin thu hồi
  job           ImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@map("import_rows")
}

model Role {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Program {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  title          String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  courses        Course[]

  @@unique([organizationId, code])
  @@map("programs")
}

model Course {
  id                 String          @id @default(cuid())
  organizationId     String
  programId          String
  code               String
  title              String
  description        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  classes            Class[]
  lectures           Lecture[]
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program            Program         @relation(fields: [programId], references: [id], onDelete: Restrict)
  teacherPreferences TeacherCourse[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("courses")
}

model TeacherCourse {
  teacherId String
  courseId  String
  createdAt DateTime @default(now())
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([teacherId, courseId])
  @@map("teacher_courses")
}

model Class {
  id            String       @id @default(cuid())
  organizationId String
  courseId       String
  teacherId      String
  code           String
  title          String
  startDate      DateTime?
  endDate        DateTime?
  status         ClassStatus  @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher        User         @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments    Enrollment[]
  liveSessions   LiveSession[]
  lectures       Lecture[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("classes")
}

model Enrollment {
  id          String           @id @default(cuid())
  organizationId String
  classId     String
  studentId   String
  status      EnrollmentStatus @default(ENROLLED)
  progress    Decimal          @default(0) @db.Decimal(5, 2)
  avgScore    Decimal          @default(0) @db.Decimal(5, 2)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([organizationId])
  @@map("enrollments")
}

model Lecture {
  id          String   @id @default(cuid())
  organizationId String
  courseId     String
  classId      String?
  ownerId      String
  title        String
  description  String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class        Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  modules      Module[]

  @@index([organizationId, ownerId])
  @@map("lectures")
}

model Module {
  id          String    @id @default(cuid())
  lectureId   String
  title       String
  description String?
  orderIndex  Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contents    Content[]
  lecture     Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([lectureId, orderIndex])
  @@map("modules")
}

model Content {
  id          String      @id @default(cuid())
  moduleId    String
  type        ContentType
  title       String
  orderIndex  Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  document    Document?
  module      Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz        Quiz?
  video       Video?

  @@unique([moduleId, orderIndex])
  @@map("contents")
}

model Video {
  id            String   @id @default(cuid())
  contentId      String   @unique
  provider       String   @default("local")
  videoUrl       String
  durationSecond Int?
  content        Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("videos")
}

model Document {
  id         String  @id @default(cuid())
  contentId  String  @unique
  fileUrl    String
  fileType   String?
  fileSize   Int?
  content    Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Quiz {
  id          String     @id @default(cuid())
  contentId    String     @unique
  title        String
  timeLimitMin Int?
  passScore    Decimal    @default(50) @db.Decimal(5, 2)
  content      Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  questions    Question[]

  @@map("quizzes")
}

model Question {
  id         String   @id @default(cuid())
  quizId      String
  content     String
  orderIndex  Int
  score       Decimal  @default(1) @db.Decimal(5, 2)
  answers     Answer[]
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, orderIndex])
  @@map("questions")
}

model Answer {
  id          String   @id @default(cuid())
  questionId   String
  content      String
  isCorrect    Boolean  @default(false)
  orderIndex   Int
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, orderIndex])
  @@map("answers")
}

model LiveSession {
  id           String              @id @default(cuid())
  classId       String
  title         String
  description   String?
  meetingUrl    String?
  startAt       DateTime
  endAt         DateTime?
  createdAt     DateTime            @default(now())
  class         Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances   SessionAttendance[]

  @@map("live_sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordOtp {
  id        String   @id @default(cuid())
  userId    String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_otps")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model SessionAttendance {
  sessionId     String
  userId        String
  status        AttendanceStatus @default(ABSENT)
  joinedAt      DateTime?
  durationMin   Int              @default(0)
  agoraUid      Int?
  liveSession   LiveSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@map("session_attendance")
}
